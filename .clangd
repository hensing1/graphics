CompileFlags:
  Add: [-xc]
Diagnostics:
  ClangTidy:
    Remove: misc-definitions-in-headers
---
If:
  PathMatch: src/color\.h

CompileFlags:
  Add: [-DIMPL_COLOR_H]
---
If:
  PathMatch: src/maths\.h

CompileFlags:
  Add: [-DIMPL_MATHS_H]
---
If:
  PathMatch: src/matrix\.h

CompileFlags:
  Add: [-DIMPL_MATRIX_H]
---
If:
  PathMatch: src/rasterize\.h
CompileFlags:
  Add: [-DIMPL_RASTERIZE_H]
---
If:
  PathMatch: src/noise\.h
CompileFlags:
  Add: [-DIMPL_NOISE_H]

---
If:
  PathMatch: src/io\.h
CompileFlags:
  Add: [-DIMPL_IO_H]
